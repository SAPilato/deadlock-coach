{
  "name": "deadlock-coach",
  "private": true,
  "description": "Personal coach app for Deadlock: match review, findings, build lab, macro map.",
  "scripts": {
    "setup": "node scripts/setup.mjs",
    "dev": "node scripts/dev.mjs",
    "dev:api": "node scripts/py.mjs -m uvicorn app.main:app --port 8000 --app-dir backend",
    "dev:web": "npm --prefix frontend run dev",
    "share": "node scripts/share.mjs",
    "set-password": "node scripts/py.mjs -m app.set_password --app-dir backend",
    "password-hash": "node scripts/py.mjs -m app.password_hash --app-dir backend",
    "test": "npm run test:api && npm run test:web",
    "test:api": "node scripts/py.mjs -m pytest backend/tests -q",
    "test:web": "npm --prefix frontend run test",
    "seed": "node scripts/py.mjs -m app.seed.build --app-dir backend"
  }
}
